{
  "name": "relevo",
  "productName": "Relevo",
  "version": "1.2.1",
  "description": "Varias sesiones de Claude en paralelo, cada una con su cuenta, y traspaso de proyectos entre ellas",
  "main": "src/main.js",
  "author": "lancaster2995",
  "license": "MIT",
  "private": true,
  "repository": "github:Lancaster2995/Cloud1",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/unit.test.js",
    "e2e": "node --test --test-concurrency=1 test/e2e.test.js",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:linux": "electron-builder --linux dir --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "io.github.lancaster2995.relevo",
    "productName": "Relevo",
    "copyright": "lancaster2995",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Relevo",
      "artifactName": "Relevo-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Relevo-${version}-portable.exe"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development"
    }
  }
}
